<androidx.constraintlayout.widget.ConstraintLayout
    android:id="@+id/signUpPage3Xml"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:background="#F0F0F0">

    <LinearLayout
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="80dp"
        android:orientation="vertical">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardSymptom"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="22dp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:paddingTop="25dp"
                android:paddingBottom="25dp"
                android:paddingStart="35dp"
                android:paddingEnd="35dp"
                android:gravity="center">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="30dp"
                    android:text="BirthSafer"
                    android:textSize="27sp"
                    android:includeFontPadding="false"
                    android:fontFamily="@font/inter_bold"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:layout_marginBottom="16dp"
                    android:text="회원가입"
                    android:textSize="20sp"
                    android:includeFontPadding="false"
                    android:fontFamily="@font/notosanskr_medium"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="기저 질환을 체크해 주세요"
                    android:textSize="20sp"
                    android:includeFontPadding="false"
                    android:fontFamily="@font/notosanskr_medium"/>
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="10dp"
                    android:gravity="start">

                    <CheckBox
                        android:id="@+id/check_diabetes_preg"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="임신성 당뇨"
                        android:textSize="20sp"
                        android:includeFontPadding="false"
                        android:fontFamily="@font/notosanskr_regular"/>

                    <CheckBox
                        android:id="@+id/check_hypertension_preg"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="임신성 고혈압"
                        android:textSize="20sp"
                        android:includeFontPadding="false"
                        android:fontFamily="@font/notosanskr_regular"/>

                    <CheckBox
                        android:id="@+id/check_diabetes"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="당뇨 (기저질환)"
                        android:textSize="20sp"
                        android:includeFontPadding="false"
                        android:fontFamily="@font/notosanskr_regular"/>

                    <CheckBox
                        android:id="@+id/check_hypertension"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="고혈압 (기저질환)"
                        android:textSize="20sp"
                        android:includeFontPadding="false"
                        android:fontFamily="@font/notosanskr_regular"/>
                </LinearLayout>
                <Button
                    android:id="@+id/NextButton3"
                    android:layout_width="160dp"
                    android:layout_height="48dp"
                    android:layout_marginTop="40dp"
                    android:layout_marginBottom="30dp"
                    android:text="회원가입"
                    android:textColor="@color/white"
                    android:textSize="16sp"
                    android:backgroundTint="#000000">
                </Button>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
