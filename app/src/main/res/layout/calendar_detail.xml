<?xml version="1.0" encoding="utf-8"?>
<!-- 캘린더 디테일 페이지
     Description : 캘린더의 날짜 셀을 클릭하면 들어오게 되는 페이지입니다 -->
<!-- Author       : 권유진
     Contributors :

     Created     : 2026-05-05
     Last Update : 2026-05-10 -->
<!-- Revision History
     v1.0.0 - UI 제작 -->
<androidx.constraintlayout.widget.ConstraintLayout
    android:id="@+id/calendarDetailXml"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F0F0F0">

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/bottomNav"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- 월 일 요약 -->
            <TextView
                android:id="@+id/todaySummaryTxt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="4월 12일 요약"
                android:textSize="24sp"
                android:layout_marginTop="80dp"
                android:layout_gravity="center"
                android:includeFontPadding="false"
                android:fontFamily="@font/notosanskr_bold"/>



            <!-- 1. 혈압 요약 카드 -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardTodayBPSummary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="22dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:paddingTop="25dp"
                    android:paddingBottom="25dp"
                    android:paddingStart="35dp"
                    android:paddingEnd="35dp">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="35dp"
                            android:layout_height="35dp"
                            android:src="@drawable/ic_blood_pressure" />

                        <Space
                            android:layout_width="6dp"
                            android:layout_height="wrap_content"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="120/80"
                            android:textSize="27sp"
                            android:includeFontPadding="false"
                            android:fontFamily="@font/inter_bold"/>

                        <Space
                            android:layout_width="2dp"
                            android:layout_height="wrap_content"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="mmhg"
                            android:textColor="#7C7C7C"
                            android:textSize="15sp"
                            android:includeFontPadding="false"
                            android:fontFamily="@font/inter_regular"/>

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:paddingTop="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="수축기 120-142"
                            android:textSize="16sp"
                            android:includeFontPadding="false"
                            android:fontFamily="@font/notosanskr_medium"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="이완기 74-92"
                            android:textSize="16sp"
                            android:includeFontPadding="false"
                            android:fontFamily="@font/notosanskr_medium"/>

                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- 2. 혈당 요약 카드 -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardTodayBSSummary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="22dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:paddingTop="25dp"
                    android:paddingBottom="25dp"
                    android:paddingStart="35dp"
                    android:paddingEnd="35dp">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="35dp"
                            android:layout_height="35dp"
                            android:src="@drawable/ic_blood_sugar" />

                        <Space
                            android:layout_width="6dp"
                            android:layout_height="wrap_content"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="100"
                            android:textSize="27sp"
                            android:includeFontPadding="false"
                            android:fontFamily="@font/inter_bold"/>

                        <Space
                            android:layout_width="2dp"
                            android:layout_height="wrap_content"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="mm/dL"
                            android:textColor="#7C7C7C"
                            android:textSize="15sp"
                            android:includeFontPadding="false"
                            android:fontFamily="@font/inter_regular"/>

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:paddingTop="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="100-147"
                            android:textSize="16sp"
                            android:includeFontPadding="false"
                            android:fontFamily="@font/notosanskr_medium"/>

                    </LinearLayout>



                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- 3. 증상 요약 카드 -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardTodaySymptomSummary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="22dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:paddingTop="25dp"
                    android:paddingBottom="25dp"
                    android:paddingStart="35dp"
                    android:paddingEnd="35dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="일일 증상"
                        android:textSize="24sp"
                        android:includeFontPadding="false"
                        android:fontFamily="@font/notosanskr_bold"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="메스꺼움, 피로감, 두통"
                        android:textSize="16sp"
                        android:includeFontPadding="false"
                        android:fontFamily="@font/notosanskr_medium"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 4. Ai 요약 카드 -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardTodayAISummary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="22dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:paddingTop="25dp"
                    android:paddingBottom="25dp"
                    android:paddingStart="35dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="AI 카드"
                        android:textSize="24sp"
                        android:includeFontPadding="false"
                        android:fontFamily="@font/notosanskr_bold"/>
                    <TextView
                        android:id="@+id/aiDietTxt2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Ai가 분석하고 있어요"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:includeFontPadding="false"
                        android:fontFamily="@font/inter_regular"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

    </ScrollView>

    <!-- 하단 Nav -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNav"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@drawable/bottom_nav_bg"
        app:menu="@menu/bottom_nav_menu"
        app:labelVisibilityMode="labeled"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>