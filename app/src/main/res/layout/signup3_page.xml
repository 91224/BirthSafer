<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <CheckBox
        android:id="@+id/check_diabetes_preg"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="임신성 당뇨"
        android:layout_marginTop="120dp"
        android:layout_marginStart="24dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>

    <CheckBox
        android:id="@+id/check_hypertension_preg"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="임신성 고혈압"
        android:layout_marginTop="16dp"
        android:layout_marginStart="24dp"
        app:layout_constraintTop_toBottomOf="@id/check_diabetes_preg"
        app:layout_constraintStart_toStartOf="parent"/>

    <CheckBox
        android:id="@+id/check_diabetes"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="당뇨"
        android:layout_marginTop="16dp"
        android:layout_marginStart="24dp"
        app:layout_constraintTop_toBottomOf="@id/check_hypertension_preg"
        app:layout_constraintStart_toStartOf="parent"/>

    <CheckBox
        android:id="@+id/check_hypertension"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="고혈압"
        android:layout_marginTop="16dp"
        android:layout_marginStart="24dp"
        app:layout_constraintTop_toBottomOf="@id/check_diabetes"
        app:layout_constraintStart_toStartOf="parent"/>

    <Button
        android:id="@+id/NextButton3"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="회원가입"
        android:layout_marginTop="32dp"
        app:layout_constraintTop_toBottomOf="@id/check_hypertension"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>