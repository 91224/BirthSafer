<?xml version="1.0" encoding="utf-8"?>

<!-- shape 전체 ai 사용 -->
<shape xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 배경색 -->
    <solid android:color="#FFFFFF"/>
    <!-- 모서리 둥글기 -->
    <corners android:radius="16dp"/>
    <!-- 테두리 (선택) -->
    <stroke
        android:width="2dp"
        android:color="#AFAFAF"/>
    <!-- 내부 여백 -->
    <padding
        android:left="12dp"
        android:right="12dp"
        android:top="8dp"
        android:bottom="8dp"/>
</shape>

